# Copy to .env and adjust. Generate secret: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-at-least-32-characters-secret-key
# URL pública que usa el navegador para /api/auth:
# - Vite solo (5173 → proxy): http://localhost:3001
# - docker compose (Spring :8080): http://localhost:8080
# - npm run dev local con Spring en Docker: http://localhost:8080
BETTER_AUTH_URL=http://localhost:8080
AUTH_SERVER_PORT=3001
# Base URL for seed/reset scripts (not the browser URL)
AUTH_SERVER_URL=http://localhost:3001

# Used by scripts/seed-dev-user.ts and future manager invite API
INVITE_API_SECRET=dev-invite-secret-change-me

# Producción: orígenes CORS extra (opcional, separados por coma)
# TRUSTED_ORIGINS=https://app.example.com
